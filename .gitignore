cosmic-launcher/
cosmic-files/
cosmic-comp/
cosmic-workspaces-epoch/
cosmic-applets/
# Any other cosmic-* component that gets forked into the workspace
cosmic-*/
# Upstream checkout kept for debugging the shm leak. Not a fork, not ours, and
# the `cosmic-*` line above does not catch it.
libcosmic/

# Local prebuilt binaries / backups kept in the workspace
cosmic-launcher-baseline-*
cosmic-launcher-system-backup

# Local, machine-specific Claude Code config (statusline, absolute paths)
.claude/

# OS / editor cruft
*.swp
*~
.DS_Store

# Scratch backups from an in-progress upstream merge — never part of the suite.
.sync-wip/
